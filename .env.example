# 网页 API 凭据改为由用户在页面填写；网页不会使用这里的模型/地图 Key。
# 以下凭据仅供 scripts/smoke_tools.py 等命令行验证。数据库和预算仍由服务端配置。
TOOL_PROVIDER=demo
PLANNING_MODE=demo
# 可切换为 postgresql+psycopg://user:password@localhost:5432/city_trip
# 默认 SQLite 路径由项目自动确定，无需配置 DATABASE_URL。

# TOOL_PROVIDER=amap 时必填；不会因缺少 Key 静默回退演示数据。
AMAP_API_KEY=

# PLANNING_MODE=llm 时使用兼容 Chat Completions 的接口。
# LLM_BASE_URL 应含 /v1 等服务前缀，程序追加 /chat/completions。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_ROUTE_CALLS=100
TOOL_TIMEOUT_SECONDS=12
MAX_RUN_SECONDS=60
